AI_OFFICE_ROOT=../../..
DASHBOARD_PORT=4310
# Leave unset for local dev / role=both without a proxy (binds all interfaces —
# today's behavior). Set to 127.0.0.1 on the Central host once a TLS reverse
# proxy (M3 Phase B, see dashboard/deploy/) is the sole LAN-facing listener,
# so the app is unreachable except through the proxy.
DASHBOARD_HOST=
SSE_HEARTBEAT_MS=15000
WATCHER_DEBOUNCE_MS=500
# Force an SSE flush within this window even under continuous file writes
# (prevents the watcher from starving live updates during long log bursts).
WATCHER_MAX_WAIT_MS=5000
LOG_TAIL_LINES=500

# Comma-separated CORS allowlist. Set to wherever the dashboard client is served.
# Must include the tester Intake UI origin too (same Vite dev server, port
# 3000, in dev — http://localhost:3000). In production, once the client is
# built and statically served by this server (see DASHBOARD_CLIENT_DIST_DIR
# below), same-origin requests don't need CORS at all.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000

# Built client (`vite build`) output dir, served statically (admin `index.html`
# + tester `intake.html`) so `/intake` loads same-origin in production.
# Defaults to ../client/dist relative to this server's build output. Leave
# unset in dev — the dir won't exist yet, so static serving is skipped and
# the Vite dev server (port 3000) serves both pages instead.
DASHBOARD_CLIENT_DIST_DIR=

# Shared bearer token required for all /api routes except /api/health.
# Leave unset for local-only use (auth disabled, server logs a warning).
# When set, the client prompts for it once and stores it in localStorage.
DASHBOARD_AUTH_TOKEN=

# --- Intake Board (Central) ---
INTAKE_DATA_DIR=./intake-data
INTAKE_ATTACHMENT_DIR=
# Where `npm run intake:ops backup` (Decision #13) writes timestamped
# SQLite snapshots (via better-sqlite3 db.backup(), online + WAL-consistent
# — not a raw file copy) + attachment manifests. Defaults to
# <INTAKE_DATA_DIR>/backups. Point this OUTSIDE the git repo and outside the
# live data dir for real deployments (e.g. a separate disk/volume) so a
# backup survives loss of the live data dir. Rotation keeps the newest 7
# daily + 4 weekly snapshot/manifest pairs, deleting older ones.
INTAKE_BACKUP_TARGET=
INTAKE_SESSION_TTL_MS=604800000
INTAKE_CODE_MAX_ATTEMPTS=10
INTAKE_CODE_WINDOW_MS=900000
INTAKE_CODE_BACKOFF_BASE_MS=500
INTAKE_SUBMIT_WINDOW_MS=3600000
INTAKE_SUBMIT_MAX_PER_WINDOW=20
INTAKE_SUBMIT_MAX_UPLOAD_BYTES=52428800
INTAKE_ATTACHMENT_MAX_BYTES=5242880
INTAKE_ATTACHMENT_MAX_PER_INTAKE=10
INTAKE_ATTACHMENT_MAX_AGGREGATE_BYTES=20971520
INTAKE_STORAGE_HIGH_WATER_BYTES=5368709120
INTAKE_CLAIM_TTL_MS=1800000

# --- Intake Board (Local, Phase B) ---
# Base URL of the Central dashboard's intake API (e.g. https://central.lan:4310).
# Leave unset until Local-side sync is configured.
INTAKE_CENTRAL_BASE_URL=
# Identifier this machine reports as `owner` when claiming intakes.
# Defaults to os.hostname() if unset.
INTAKE_LOCAL_MACHINE_ID=

# Closed set of repos an intake may be scoped to (Decision #5). JSON array of
# {name, path}. Tester-supplied text (product_hint) can only ever match into
# this configured list — it can never add a repo. Default [] (no repos
# reachable) until an operator configures this.
# Example:
# INTAKE_REPO_ALLOWLIST=[{"name":"Games-Labs-Wallet","path":"/repos/Games-Labs-Wallet"},{"name":"Games-Labs-Missions","path":"/repos/Games-Labs-Missions"}]
INTAKE_REPO_ALLOWLIST=

# Closed set of product options offered in the tester submission UI. JSON
# array of {value, label}. Operator-configured only. Default [] (no options)
# until an operator configures this. Selecting "Other/not sure" in the UI
# always sends an empty product_hint, regardless of this list's contents.
# Example:
# INTAKE_PRODUCT_LIST=[{"value":"Games-Labs-Wallet","label":"Wallet"}]
INTAKE_PRODUCT_LIST=

# Deployment role of this dashboard instance: 'central' | 'local' | 'both'.
# 'local' (or 'both') mounts the /api/local/* admin routes (refresh, claim,
# triage-package, triage-result, promote). Defaults to 'both'. [PLAN-ASSUMPTION]
INTAKE_ROLE=both

# Durable Local-side cursor file tracking the last change_seq consumed from
# Central's changes feed (Decision #14). Defaults under INTAKE_DATA_DIR.
INTAKE_SYNC_CURSOR_PATH=

# Where Local promotion writes TASK-<PREFIX>-NNN run directories. Defaults to
# the same runs/ root the rest of the dashboard watches (AI_OFFICE_ROOT/runs).
INTAKE_RUNS_DIR=

# Admin auth mode for makeAdminAuth: 'required' | 'disabled'. Defaults to
# 'required', which hard-fails 503 on any admin route until a real admin
# credential is provisioned (never passes through open).
# !!! DANGER: 'disabled' skips admin auth entirely. Local dev/tests ONLY.
# !!! The LAN deployment (Central or Local) MUST NEVER set this to 'disabled'.
INTAKE_ADMIN_AUTH_MODE=required
#
# Admin credentials are provisioned with `npm run intake:ops provision-admin
# --label <l> --caps <c1,c2>`. Each Central admin route requires ONE capability:
#   intake:read=changes feed  intake:claim=claim  intake:triage=triage
#   intake:promote=promotion  intake:admin=/admin/* + Local /api/local/* surface
# Provision TWO credentials (Decision #1/#2):
#   - Local machine's CENTRAL secret (makeCentralClient) --caps
#     intake:read,intake:claim,intake:triage,intake:promote  <-- NOT just intake:admin
#     (only intake:admin => refresh/claim/triage/promote silently 403; #1 footgun)
#   - Owner's Local admin-surface secret --caps intake:admin
# NOTE (Decision #13): backup snapshots the SQLite DB only — attachment BLOBS are
# NOT copied by `intake:ops backup`; replicate the attachment dir separately.

# dashboard/deploy/Caddyfile — terminates TLS for the Central Intake service.
#
# Internal hostname (pick one and add it to LAN DNS, or to each tester
# machine's hosts file pointing at the Central host's LAN IP, e.g.
# 192.168.1.140). This file assumes the placeholder below — replace it with
# whatever hostname you actually register.
intake.games-labs.lan {
	# Caddy's built-in internal CA. Distribute its root cert to every tester
	# machine's trust store (see README-tls.md) so browsers show no warning.
	tls internal

	encode zstd gzip

	# The Central Express app must be started with DASHBOARD_HOST=127.0.0.1
	# so Caddy is the ONLY LAN-facing listener (see README-tls.md Step 1).
	reverse_proxy 127.0.0.1:4310 {
		header_up X-Forwarded-Proto https
	}

	# Slightly above the 5MB per-attachment cap (INTAKE_ATTACHMENT_MAX_BYTES)
	# so a single multipart submission with one attachment at the cap still
	# fits through the proxy; the app's own limits are the real enforcement.
	request_body {
		max_size 6MB
	}
}

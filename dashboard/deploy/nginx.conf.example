# dashboard/deploy/nginx.conf.example — nginx equivalent of ./Caddyfile,
# for operators who prefer nginx over Caddy. Not auto-HTTPS: you must supply
# your own internal CA cert/key (see README-tls.md "Generating a cert with
# your own internal CA" for one way to produce them).
#
# Replace intake.games-labs.lan and the cert/key paths with your real values.

server {
	listen 443 ssl;
	server_name intake.games-labs.lan;

	ssl_certificate     /etc/nginx/certs/intake.games-labs.lan.crt;
	ssl_certificate_key /etc/nginx/certs/intake.games-labs.lan.key;
	ssl_protocols       TLSv1.2 TLSv1.3;

	# Slightly above the 5MB per-attachment cap (INTAKE_ATTACHMENT_MAX_BYTES);
	# the app's own limits are the real enforcement.
	client_max_body_size 6m;

	location / {
		# The Central Express app must be started with DASHBOARD_HOST=127.0.0.1
		# so nginx is the ONLY LAN-facing listener (see README-tls.md Step 1).
		proxy_pass http://127.0.0.1:4310;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}
}

# Redirect plain HTTP to HTTPS (optional but recommended — otherwise a
# tester who types http:// gets nothing, since the app itself only listens
# on loopback).
server {
	listen 80;
	server_name intake.games-labs.lan;
	return 301 https://$host$request_uri;
}
